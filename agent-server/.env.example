# ===== 复制本文件为 .env 并填入你自己的值（.env 已被 .gitignore 排除，不会上传）=====

# 【必填】Deepseek API Key —— 在 https://platform.deepseek.com/api_keys 生成
# 仅服务端使用，绝不暴露给前端 / 不进代码库
DEEPSEEK_API_KEY=sk-your-key-here

# 【可选】模型名（默认 deepseek-v4-flash；复杂推理可用 deepseek-v4-pro）
DEEPSEEK_MODEL=deepseek-v4-flash

# 【可选】Deepseek 接口地址（默认官方，无需改）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 【可选】端口
PORT=3000

# 【可选】重复问题缓存时长（分钟）
CACHE_TTL_MIN=30

# 【可选】每 IP 每分钟最大提问数（防刷/控成本）
RATE_LIMIT_PER_MIN=20
